<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hệ Thống Quản Lý Chỉ Số Điện & Nước</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100vh;
      overflow: hidden;
      background-color: #f8f9fa;
    }
    
    .iframe-wrapper {
      position: absolute;
      top: -28px; /* Đã điều chỉnh từ -38px xuống -28px để giấu vừa đủ banner Google */
      left: 0;
      width: 100%;
      height: calc(100% + 28px);
    }

    iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
  </style>
</head>
<body>

  <div class="iframe-wrapper">
    <iframe src="https://script.google.com/macros/s/AKfyeby4Cean2-dn88VBE8yXE5zQx8T3AGCPK8I4-MBTQHIRnfxU1go4Dg9Gg5pVIyPJu39N/exec" allowfullscreen></iframe>
  </div>

</body>
</html>
